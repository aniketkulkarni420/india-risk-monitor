# Cloudflare Pages config · hormuz-watch
# Adds the KV namespace bindings needed for V2 snapshot caching.
#
# DEPLOY STEPS (Aniket-side, one-time):
#   1. npx wrangler kv namespace create HORMUZ_KV
#      → copy the resulting `id` into the binding below
#   2. npx wrangler kv namespace create HORMUZ_KV --preview
#      → copy the resulting `id` into preview_id below
#   3. git add wrangler.toml && git commit && git push
#   4. CF Pages auto-deploys · KV binding becomes active
#
# Required env vars in CF Pages project settings (Production):
#   EIA_KEY      · EIA v2 API key · existing
#   GFW_TOKEN    · Global Fishing Watch JWT · existing
#   AISHUB_KEY   · OPTIONAL · AISHub free-tier API key (sign up at aishub.net)
#   CRON_SECRET  · shared secret for /api/cron-update auth
#   HORMUZ_TRANSITS_24H · OPTIONAL · manual override for transit count until
#                        AIS source wires · falls back to 84 if unset
#   HORMUZ_INBOUND / HORMUZ_OUTBOUND / HORMUZ_DARK / HORMUZ_BDTI · OPTIONAL

name = "hormuz-watch"
compatibility_date = "2024-09-01"
pages_build_output_dir = "."

[[kv_namespaces]]
binding = "HORMUZ_KV"
id = "REPLACE_WITH_PROD_NAMESPACE_ID"
preview_id = "REPLACE_WITH_PREVIEW_NAMESPACE_ID"
