# Dependencies
node_modules/

# Build artifacts (regenerated by `npm run bundle`)
app/dist/

# Logs (per-day JSONL, generated by ingest)
logs/

# Visual audit output (regenerated by `npm run audit:visual`)
audit-output/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Local env (don't commit secrets)
.env
.env.local

# Playwright / test caches
test-results/
playwright-report/
playwright/.cache/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
