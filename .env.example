# Local-machine ingest secrets. Copy to `.env` and fill in your keys.
# `.env` is gitignored so secrets never leave your laptop.
#
# All three are FREE — sign up links in scripts/ingest/parsers/llm_extract_v1.mjs.

# Free LLM extraction fallback (Step 11)
# Pick ONE or stack all three for redundancy.
GROQ_API_KEY=
GEMINI_API_KEY=
CF_API_TOKEN=
CF_ACCOUNT_ID=

# data.gov.in resource API (Step 7)
# Optional — CSV mode works without a key, API mode needs one.
DATAGOVIN_API_KEY=
